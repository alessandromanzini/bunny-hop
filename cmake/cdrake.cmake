# ----------------------------------------
# scripts/private/target_configure_strict.cmake
# ----------------------------------------
#
# _cdrk_target_configure_strict( <TARGET_NAME> [ENABLE_EXCEPTIONS] [ENABLE_RTTI] [<option>...] )
#
# Enables warnings as errors on TARGET_NAME and disables exceptions and RTTI unless enabled.
# Any other argument is added as a private compile option.
function( _cdrk_target_configure_strict TARGET_NAME )
    #
    # --- Argument parsing -----------------------------------------------
    # ENABLE_EXCEPTIONS / ENABLE_RTTI: opt-in flags, both OFF unless given.
    # PARSE_ARGV skips TARGET_NAME (index 1).
    #
    cmake_parse_arguments( PARSE_ARGV 1 ARG "ENABLE_EXCEPTIONS;ENABLE_RTTI" "" "" )
    #
    # --- Diagnostics flags --------------------------------------------
    # PRIVATE: these only affect how *this* target is compiled, not its
    # externally visible configuration, therefore they are private.
    #
    target_compile_options(
            "${TARGET_NAME}" PRIVATE
            "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:/W4;/WX;/permissive-;/w14062;/w14165;/w14242;/w14254;/w14263;/w14265;/w14287;/w14296;/w14311;/w14545;/w14546;/w14547;/w14549;/w14555;/w14619;/w14640;/w14826;/w14905;/w14906;/w14928;/fp:precise;/Zc:__cplusplus;/Zc:inline;/Zc:preprocessor>"
            "$<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang,AppleClang>:-Wall;-Wextra;-Wpedantic;-Werror;-Wshadow;-Wnon-virtual-dtor;-Wold-style-cast;-Wcast-align;-Wunused;-Woverloaded-virtual;-Wconversion;-Wsign-conversion;-Wdouble-promotion;-Wformat=2;-Wno-unknown-pragmas>"
            ${ARG_UNPARSED_ARGUMENTS} )
    #
    # --- ABI-affecting flags ------------------------------------------
    # PUBLIC, CXX-only: exception/RTTI configuration is baked into any
    # exported C++20 module BMI. If a consumer target links this one but
    # was compiled with a different setting, clang/MSVC rejects the .pcm
    # with a "configuration mismatch". For this reason these are public.
    #
    if( ARG_ENABLE_EXCEPTIONS )
        #
        set( _msvc_eh_flag "/EHsc" )
        set( _gnu_exception_flag "-fexceptions" )
        set( ARG_ENABLE_EXCEPTIONS ON )
        #
    else()
        #
        set( _msvc_eh_flag "/EHs-c-" )
        set( _gnu_exception_flag "-fno-exceptions" )
        set( ARG_ENABLE_EXCEPTIONS OFF )
        #
    endif()
    #
    if( ARG_ENABLE_RTTI )
        #
        set( _msvc_rtti_flag "/GR" )
        set( _gnu_rtti_flag "-frtti" )
        set( ARG_ENABLE_RTTI ON )
        #
    else()
        #
        set( _msvc_rtti_flag "/GR-" )
        set( _gnu_rtti_flag "-fno-rtti" )
        set( ARG_ENABLE_RTTI OFF )
        #
    endif()
    #
    target_compile_options(
            "${TARGET_NAME}" PUBLIC
            "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:${_msvc_eh_flag};${_msvc_rtti_flag}>"
            "$<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang,AppleClang>:${_gnu_exception_flag};${_gnu_rtti_flag}>" )
    #
    # _HAS_EXCEPTIONS=0 must only be defined when exceptions are disabled.
    if( NOT ARG_ENABLE_EXCEPTIONS )
        target_compile_definitions( "${TARGET_NAME}" PUBLIC "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:_HAS_EXCEPTIONS=0>" )
    endif()
    #
    message( STATUS "${TARGET_NAME}: strict compilation options applied (EXCEPTIONS=${ARG_ENABLE_EXCEPTIONS}, RTTI=${ARG_ENABLE_RTTI})." )
    #
endfunction()

#
# ----------------------------------------
# scripts/private/add_library_target.cmake
# ----------------------------------------
#
# _cdrk_inject_target_api( <TARGET_NAME> <API_MACRO> <STATIC|BUILD|IMPORT> )
#
# Defines API_MACRO on TARGET_NAME: empty for STATIC, symbol export while compiling
# the target for BUILD, symbol import for its consumers for IMPORT.
#
# This also sets hidden symbol visibility by default for cross-platform uniformity.
function( _cdrk_inject_target_api TARGET_NAME API_MACRO MODE )
    #
    # 1. Pick the export/import attributes for the current platform.
    if( WIN32 OR CYGWIN )
        #
        set( EXPORT_ATTRIBUTE "__declspec(dllexport)" )
        set( IMPORT_ATTRIBUTE "__declspec(dllimport)" )
        #
    elseif( CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang|IntelLLVM)$" )
        #
        set( EXPORT_ATTRIBUTE "__attribute__((visibility(\"default\")))" )
        set( IMPORT_ATTRIBUTE "${EXPORT_ATTRIBUTE}" )
        #
    else()
        #
        message( FATAL_ERROR "${TARGET_NAME}: cannot define ${API_MACRO}, unsupported compiler '${CMAKE_CXX_COMPILER_ID}'!" )
        #
    endif()
    #
    # 2. Define the macro: empty for static, export while building, import for consumers.
    if( MODE STREQUAL "STATIC" )
        #
        target_compile_definitions( "${TARGET_NAME}" PUBLIC "${API_MACRO}=" )
        #
    elseif( MODE STREQUAL "BUILD" )
        #
        target_compile_definitions( "${TARGET_NAME}" PRIVATE "${API_MACRO}=${EXPORT_ATTRIBUTE}" )
        set_target_properties( "${TARGET_NAME}" PROPERTIES
                               CXX_VISIBILITY_PRESET hidden
                               VISIBILITY_INLINES_HIDDEN ON )
        #
    elseif( MODE STREQUAL "IMPORT" )
        #
        target_compile_definitions( "${TARGET_NAME}" INTERFACE "${API_MACRO}=${IMPORT_ATTRIBUTE}" )
        #
    else()
        #
        message( FATAL_ERROR "_cdrk_inject_target_api: unknown mode '${MODE}'!" )
        #
    endif()
    #
endfunction()

# _cdrk_add_library_target( <STATIC|SHARED|LIBRARY> <TARGET_NAME> <MACRO_TAG> <OUT_SOURCE_TARGET> <OUT_LINK_TARGETS> )
#
# Adds the library targets, see cdrk_module. OUT_SOURCE_TARGET receives the target compiling
# the sources (the object library for LIBRARY), OUT_LINK_TARGETS the targets to link against.
#
# The export macro is injected in the target with the following format: <MACRO_TAG>_API
function( _cdrk_add_library_target LIB_TYPE MACRO_TAG TARGET_NAME OUT_SOURCE_TARGET OUT_LINK_TARGETS )
    #
    string( TOUPPER "${MACRO_TAG}_API" API_MACRO )
    string( MAKE_C_IDENTIFIER "${API_MACRO}" API_MACRO )
    #
    if( LIB_TYPE STREQUAL "STATIC" )
        #
        add_library( "${TARGET_NAME}" STATIC )
        _cdrk_inject_target_api( "${TARGET_NAME}" "${API_MACRO}" STATIC )
        #
        set( SOURCE_TARGET "${TARGET_NAME}" )
        set( LINK_TARGETS "${TARGET_NAME}" )
        #
    elseif( LIB_TYPE STREQUAL "SHARED" )
        #
        add_library( "${TARGET_NAME}" SHARED )
        _cdrk_inject_target_api( "${TARGET_NAME}" "${API_MACRO}" BUILD )
        _cdrk_inject_target_api( "${TARGET_NAME}" "${API_MACRO}" IMPORT )
        #
        set( SOURCE_TARGET "${TARGET_NAME}" )
        set( LINK_TARGETS "${TARGET_NAME}" )
        #
    elseif( LIB_TYPE STREQUAL "LIBRARY" )
        #
        set( OBJECT_TARGET "${TARGET_NAME}-object" )
        set( STATIC_TARGET "${TARGET_NAME}-static" )
        #
        # The object library compiles the sources once for both the static and shared libraries,
        # so users can link to either without building twice. PIC is needed by the shared one.
        add_library( "${OBJECT_TARGET}" OBJECT )
        set_target_properties( "${OBJECT_TARGET}" PROPERTIES POSITION_INDEPENDENT_CODE ON )
        _cdrk_inject_target_api( "${OBJECT_TARGET}" "${API_MACRO}" BUILD )
        #
        # Add static/shared library targets and link them against object.
        add_library( "${STATIC_TARGET}" STATIC )
        target_link_libraries( "${STATIC_TARGET}" PUBLIC "${OBJECT_TARGET}" )
        _cdrk_inject_target_api( "${STATIC_TARGET}" "${API_MACRO}" STATIC )
        #
        add_library( "${TARGET_NAME}" SHARED )
        target_link_libraries( "${TARGET_NAME}" PUBLIC "${OBJECT_TARGET}" )
        _cdrk_inject_target_api( "${TARGET_NAME}" "${API_MACRO}" IMPORT )
        #
        # Both share the output name, except on Windows where the static and import libraries would clash as <name>.lib.
        if( NOT WIN32 )
            #
            set_target_properties( "${STATIC_TARGET}" PROPERTIES OUTPUT_NAME "${TARGET_NAME}" )
            #
        endif()
        #
        set( SOURCE_TARGET "${OBJECT_TARGET}" )
        set( LINK_TARGETS "${TARGET_NAME}" "${STATIC_TARGET}" )
        #
    else()
        #
        message( FATAL_ERROR "_cdrk_add_library_target: library type '${LIB_TYPE}' is not recognized!" )
        #
    endif()
    #
    set( ${OUT_SOURCE_TARGET} "${SOURCE_TARGET}" PARENT_SCOPE )
    set( ${OUT_LINK_TARGETS} ${LINK_TARGETS} PARENT_SCOPE )
    #
endfunction()


# cdrk_module( <MODULE_NAME> <EXECUTABLE|STATIC|SHARED|LIBRARY>
#              [INCLUDE_DIRECTORY <dir>]
#              [SOURCE_DIRECTORY <dir>]
#              [STRICT | STRICT_ARGS <arg>...] )
#
# Adds the target <namespace>_<MODULE_NAME> with alias <namespace>::<MODULE_NAME>, where
# <namespace> is read from ${PROJECT_NAME}_NAMESPACE. If no namespace is defined, the
# target is defined as <MODULE_NAME> with no alias.
# The complete target name is returned in <MODULE_TARGET> on the parent scope. Same goes
# for directory paths to <MODULE_INC_DIR> and <MODULE_SRC_DIR>.
# Sources can be added with cdrk_module_sources.
#
# EXECUTABLE:         an executable, runtime DLLs are copied next to it on Windows.
# STATIC/SHARED:      a single library of that type.
# LIBRARY:            both, sources compiled once; the static one is <namespace>::<MODULE_NAME>-static.
#                     Libraries define <NAMESPACE>_<MODULE_NAME>_EXPORT (upper case) to mark exported symbols.
# INCLUDE_DIRECTORY:  add directory to module target. if <MODULE_TYPE> is a library type, this is set
#                     as public directory.
# SOURCE_DIRECTORY:   add directory to module target, strictly private.
# STRICT:             applies strict compilation options with their defaults.
# STRICT_ARGS:        applies strict compilation options with these arguments
#                     (ENABLE_EXCEPTIONS, ENABLE_RTTI, extra compile options).
function( cdrk_module MODULE_NAME MODULE_TYPE )
    #
    # 1. Parse and validate arguments.
    cmake_parse_arguments( PARSE_ARGV 2 ARG "STRICT" "INCLUDE_DIRECTORY;SOURCE_DIRECTORY" "STRICT_ARGS" )
    #
    if( ARG_UNPARSED_ARGUMENTS )
        #
        message( FATAL_ERROR "cdrk_module: unexpected arguments '${ARG_UNPARSED_ARGUMENTS}'!" )
        #
    endif()
    #
    # STRICT_ARGS implies STRICT, even if left empty.
    if( DEFINED ARG_STRICT_ARGS OR "STRICT_ARGS" IN_LIST ARG_KEYWORDS_MISSING_VALUES )
        #
        set( ARG_STRICT ON )
        #
    endif()
    #
    # 2. Name the target, namespaced only if the project defines a namespace.
    if( DEFINED "${PROJECT_NAME}_NAMESPACE" )
        #
        set( TARGET_NAME "${${PROJECT_NAME}_NAMESPACE}_${MODULE_NAME}" )
        set( ALIAS_NAME "${${PROJECT_NAME}_NAMESPACE}::${MODULE_NAME}" )
        #
    else()
        #
        set( TARGET_NAME "${MODULE_NAME}" )
        set( ALIAS_NAME "" )
        #
    endif()
    #
    # 3. Add the module targets.
    if( MODULE_TYPE STREQUAL "EXECUTABLE" )
        #
        add_executable( "${TARGET_NAME}" )
        set( SOURCE_TARGET "${TARGET_NAME}" )
        set( LINK_TARGETS "${TARGET_NAME}" )
        #
        # Windows has no rpath, so copy the runtime DLLs next to the executable ('true' if none).
        if( WIN32 )
            #
            set( RUNTIME_DLLS "$<TARGET_RUNTIME_DLLS:${TARGET_NAME}>" )
            add_custom_command( TARGET "${TARGET_NAME}" POST_BUILD
                                COMMAND "${CMAKE_COMMAND}" -E "$<IF:$<BOOL:${RUNTIME_DLLS}>,copy_if_different,true>" "${RUNTIME_DLLS}" "$<TARGET_FILE_DIR:${TARGET_NAME}>"
                                COMMAND_EXPAND_LISTS VERBATIM )
            #
        endif()
        #
    elseif( MODULE_TYPE MATCHES "^(STATIC|SHARED|LIBRARY)$" )
        #
        _cdrk_add_library_target( "${MODULE_TYPE}" "${MODULE_NAME}" "${TARGET_NAME}" SOURCE_TARGET LINK_TARGETS )
        #
    else()
        #
        message( FATAL_ERROR "Module type '${MODULE_TYPE}' is not recognized!" )
        #
    endif()
    #
    # 4. Name the targets <namespace>::<MODULE_NAME>[-static|-object] for consumers, when
    #    exported (EXPORT_NAME) and, for the linkable ones, in this build (alias).
    string( LENGTH "${TARGET_NAME}" TARGET_NAME_LENGTH )
    foreach( MODULE_TARGET IN LISTS LINK_TARGETS SOURCE_TARGET )
        #
        string( SUBSTRING "${MODULE_TARGET}" "${TARGET_NAME_LENGTH}" -1 SUFFIX )
        set_target_properties( "${MODULE_TARGET}" PROPERTIES EXPORT_NAME "${MODULE_NAME}${SUFFIX}" )
        #
        if( ALIAS_NAME AND MODULE_TARGET IN_LIST LINK_TARGETS AND NOT TARGET "${ALIAS_NAME}${SUFFIX}" )
            #
            if( MODULE_TYPE STREQUAL "EXECUTABLE" )
                #
                add_executable( "${ALIAS_NAME}${SUFFIX}" ALIAS "${MODULE_TARGET}" )
                #
            else()
                #
                add_library( "${ALIAS_NAME}${SUFFIX}" ALIAS "${MODULE_TARGET}" )
                #
            endif()
            #
        endif()
        #
    endforeach()
    #
    # 5. Remember the module layout for cdrk_module_sources. Executables have no consumers,
    #    so their file sets stay private.
    if( MODULE_TYPE STREQUAL "EXECUTABLE" )
        #
        set( FILE_SET_SCOPE PRIVATE )
        #
    else()
        #
        set( FILE_SET_SCOPE PUBLIC )
        #
    endif()
    #
    # 6. Configure the target that compiles the sources and...
    target_include_directories( "${SOURCE_TARGET}"
                                "${FILE_SET_SCOPE}" "$<BUILD_INTERFACE:${ARG_INCLUDE_DIRECTORY}>"
                                PRIVATE "${ARG_SOURCE_DIRECTORY}" )
    #
    # ... if args ask for it, apply strict options.
    if( ARG_STRICT )
        #
        _cdrk_target_configure_strict( "${SOURCE_TARGET}" ${ARG_STRICT_ARGS} )
        #
    endif()
    #
    set_target_properties( "${TARGET_NAME}" PROPERTIES
                           _CDRK_SOURCE_TARGET "${SOURCE_TARGET}"
                           _CDRK_LINK_TARGETS "${LINK_TARGETS}"
                           _CDRK_FILE_SET_SCOPE "${FILE_SET_SCOPE}"
                           _CDRK_INCLUDE_DIRECTORY "${ARG_INCLUDE_DIRECTORY}"
                           _CDRK_SOURCE_DIRECTORY "${ARG_SOURCE_DIRECTORY}" )
    #
    set( MODULE_TARGET "${TARGET_NAME}" PARENT_SCOPE )
    set( MODULE_INC_DIR "${ARG_INCLUDE_DIRECTORY}" PARENT_SCOPE )
    set( MODULE_SRC_DIR "${ARG_SOURCE_DIRECTORY}" PARENT_SCOPE )
    #
endfunction()

